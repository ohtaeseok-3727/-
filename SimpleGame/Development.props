<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutDir>$(MSBuildThisFileDirectory)..\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\intermediate\$(Platform)\$(Configuration)\</IntDir>
    <LocalDebuggerCommand>$(TargetPath)</LocalDebuggerCommand>
    <LocalDebuggerWorkingDirectory>$(OutDir)</LocalDebuggerWorkingDirectory>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <Link>
      <AdditionalDependencies>opengl32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
    </ClCompile>
  </ItemDefinitionGroup>
  <Target Name="CopyDevelopmentRuntime" AfterTargets="Build">
    <PropertyGroup>
      <RuntimeDependencyDir>$(MSBuildThisFileDirectory)Dependencies\</RuntimeDependencyDir>
      <RuntimeDependencyDir Condition="'$(Platform)'=='x64'">$(MSBuildThisFileDirectory)Dependencies\x64\</RuntimeDependencyDir>
    </PropertyGroup>
    <ItemGroup>
      <DevelopmentDll Include="$(RuntimeDependencyDir)freeglut.dll;$(RuntimeDependencyDir)glew32.dll" />
      <DevelopmentShader Include="$(MSBuildThisFileDirectory)Shaders\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(DevelopmentDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DevelopmentShader)" DestinationFiles="@(DevelopmentShader->'$(OutDir)Shaders\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
